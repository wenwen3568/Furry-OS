#!/bin/bash -e
# 安装 Calamares 和 GNOME Tweaks（这些不会引起冲突）
apt-get update
apt-get install -y calamares gnome-tweaks

# ===== 创建 Wine 安装脚本 =====
cat > /usr/local/bin/install-wine.sh << 'EOF'
#!/bin/bash
# Wine 11.x 安装脚本（适用于 Ubuntu 22.04）
set -e

# 检查是否已安装 wine
if command -v wine &>/dev/null; then
    zenity --info --text="Wine 已安装，无需重复安装。" --title="Wine 安装" 2>/dev/null || echo "Wine already installed."
    exit 0
fi

# 询问用户是否安装
if ! zenity --question --text="是否现在安装 Wine 11.x？\n安装过程可能需要 5-10 分钟。" --title="Wine 安装" 2>/dev/null; then
    echo "用户取消安装。"
    exit 0
fi

# 1. 启用 32 位架构
sudo dpkg --add-architecture i386

# 2. 添加 WineHQ 仓库
sudo mkdir -p /usr/share/keyrings
curl -fsSL https://dl.winehq.org/wine-builds/winehq.key | sudo gpg --dearmor -o /usr/share/keyrings/winehq.gpg

cat <<WINE_SOURCE | sudo tee /etc/apt/sources.list.d/winehq.sources
Types: deb
URIs: https://dl.winehq.org/wine-builds/ubuntu
Suites: $(lsb_release -cs)
Components: main
Architectures: amd64 i386
Signed-By: /usr/share/keyrings/winehq.gpg
WINE_SOURCE

# 3. 安装 Wine
sudo apt update
sudo apt install -y --install-recommends winehq-stable

# 4. 完成提示
zenity --info --text="Wine 安装完成！\n你可以在终端输入 'wine --version' 查看版本。" --title="Wine 安装" 2>/dev/null || echo "Wine installation finished."
EOF

# 赋予执行权限
chmod +x /usr/local/bin/install-wine.sh

# ===== 创建桌面快捷方式 =====
cat > /usr/share/applications/install-wine.desktop << 'EOF'
[Desktop Entry]
Type=Application
Name=Install Wine
Comment=一键安装 Wine 11.x
Exec=/usr/local/bin/install-wine.sh
Icon=wine
Terminal=true
Categories=System;
EOF

# 清理缓存
apt-get clean

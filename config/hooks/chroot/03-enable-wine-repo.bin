#!/bin/bash -e
# 启用 32 位架构
dpkg --add-architecture i386

# 添加 Wine 官方源
mkdir -p /etc/apt/keyrings
wget -O /etc/apt/keyrings/winehq-archive.key https://dl.winehq.org/wine-builds/winehq.key
echo "deb [signed-by=/etc/apt/keyrings/winehq-archive.key] https://dl.winehq.org/wine-builds/ubuntu/ jammy main" > /etc/apt/sources.list.d/winehq-jammy.list

# 更新源并安装软件包
apt-get update
apt-get install -y \
    calamares \
    gnome-tweaks \
    winehq-stable

# ===== 关键修复：提前撤销 dpkg-divert 修改 =====
dpkg-divert --remove /usr/sbin/start-stop-daemon 2>/dev/null || true

# 清理缓存
apt-get clean
